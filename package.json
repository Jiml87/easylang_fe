    "@types/node": "^22.13.4",
    "@types/node-jose": "^1.1.13",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/react-facebook-login": "^4.1.11",
    "@typescript/native": "npm:typescript@7.0.2",
    "cssnano": "^7.0.4",
    "eslint": "^9",
    "eslint-config-next": "16.3.4",
    "husky": "^9.0.1",
    "lint-staged": "^15.2.0",
    "pinst": "^3.0.0",
    "tailwindcss": "^3.4.7",
    "typescript": "npm:@typescript/typescript6@6.0.2"
