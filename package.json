{
  "name": "mywords_ui",
  "version": "1.3.0",
  "private": true,
  "author": "Viacheslav Semenenko",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "format": "biome format --write .",
    "format:check": "biome ci .",
    "typecheck": "tsc --noEmit",
    "prepare": "husky"
  },
  "lint-staged": {
    "*": "biome format --write --no-errors-on-unmatched --files-ignore-unknown=true",
    "**/*.{ts,tsx}": "bash -c 'tsc --noEmit'"
  },
  "dependencies": {
    "@assistant-ui/react": "^0.15.36",
    "@react-oauth/google": "^0.13.5",
    "@reduxjs/toolkit": "^2.14.0",
    "autoprefixer": "^10.6.2",
    "axios": "^1.21.1",
    "final-form": "^4.20.10",
    "lodash.debounce": "^4.0.8",
    "next": "16.4.6",
    "primeicons": "^8.0.2",
    "primereact": "^10.9.9",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-final-form": "^6.5.9",
    "react-redux": "^9.3.1",
    "react-swipeable": "^7.0.2",
    "tailwind-merge": "^2.6.1"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.8",
    "@tailwindcss/typography": "^0.5.20",
    "@types/lodash.debounce": "^4.0.9",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@typescript/native": "npm:typescript@7.0.2",
    "cssnano": "^8.0.10",
    "husky": "^9.1.7",
    "lint-staged": "^16.4.0",
    "tailwindcss": "^3.4.19",
    "typescript": "npm:@typescript/typescript6@6.0.2"
  }
}
