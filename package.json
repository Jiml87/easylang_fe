    "@reduxjs/toolkit": "^2.2.6",
    "autoprefixer": "^10.4.19",
    "axios": "^1.6.2",
    "final-form": "^4.20.10",
    "framer-motion": "^10.16.16",
    "humps": "^2.0.1",
    "jsonwebtoken": "^9.0.2",
    "lodash.debounce": "^4.0.8",
    "next": "16.3.4",
    "next-themes": "^0.2.1",
    "primeicons": "^7.0.0",
    "primereact": "^10.7.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-final-form": "^6.5.9",
    "react-query": "^3.39.3",
