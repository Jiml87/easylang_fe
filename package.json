{
  "name": "mywords_ui",
  "version": "1.0.21",
  "private": true,
  "author": "Viacheslav Semenenko",
  "engines": {
    "node": ">=20.9.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "format": "biome format --write .",
    "format:check": "biome ci .",
    "typecheck": "tsc --noEmit",
    "prepare": "husky"
  },
  "lint-staged": {
    "*": "biome format --write --no-errors-on-unmatched --files-ignore-unknown=true",
